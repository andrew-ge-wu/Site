{
  "name": "circuitwall-site",
  "version": "2.1.0",
  "description": "CircuitWall Consultancy Website - Professional Java, Spring, Big Data & ML consulting services",
  "scripts": {
    "dev": "hugo serve --buildDrafts --buildFuture --disableFastRender",
    "build": "hugo --gc --minify --enableGitInfo",
    "build:dev": "hugo --buildDrafts --buildFuture",
    "clean": "rimraf public resources",
    "lint": "htmlhint public/**/*.html",
    "optimize": "sharp -i \"static/img/**/*.{jpg,jpeg,png}\" -o static/img/optimized --format webp",
    "serve:prod": "hugo serve --environment production --disableLiveReload",
    "deploy": "npm run build && netlify deploy --prod --dir=public",
    "test": "npm run build && npm run lint"
  },
  "keywords": [
    "hugo",
    "static-site",
    "consulting",
    "java",
    "spring",
    "machine-learning",
    "big-data",
    "stockholm"
  ],
  "author": "Andrew Wu <contact@circuitwall.net>",
  "license": "MIT",
  "homepage": "https://circuitwall.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/CircuitWall/site"
  },
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "netlify-cli": "^26.0.1",
    "rimraf": "^6.0.1",
    "sharp-cli": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
